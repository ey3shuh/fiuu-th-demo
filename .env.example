# Copy this file to .env and fill in the keys. Never commit or share .env publicly.

# mock = fake Fiuu page on your laptop (no keys needed)
# live = real Fiuu gateway (fill in everything below)
FIUU_MODE=mock

FIUU_MERCHANT_ID=mobilexdkth_Dev
FIUU_VERIFY_KEY=
FIUU_SECRET_KEY=
# Base URL of the hosted payment page, ending in /pay/
# The merchant ID is added automatically, e.g. https://pay.fiuu.co.th/RMS/pay/<merchantID>/
FIUU_PAYMENT_URL=https://pay.fiuu.co.th/RMS/pay/
# md5 | sha1 | sha256 | sha512 — must match the merchant's Hash Algorithm Setting
FIUU_HASH=md5
